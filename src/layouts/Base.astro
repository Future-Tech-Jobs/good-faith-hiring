---
import '@fontsource-variable/figtree';
import '@fontsource-variable/bricolage-grotesque';
import '../styles/global.css';
import figtreeUrl from '@fontsource-variable/figtree/files/figtree-latin-wght-normal.woff2?url';
import bricolageUrl from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, absolute, fullTitle } from '../lib/site';

interface Props {
  title: string;
  description: string;
  /** Slug of the share image under /og/. */
  og: string;
  jsonLd?: Record<string, unknown>[];
  ogType?: 'website' | 'article';
}

const { title, description, og, jsonLd = [], ogType = 'website' } = Astro.props;
const isError = Astro.url.pathname.startsWith('/404');
// Workers Builds sets the branch. Anything but main is a preview, which must not be indexed.
const branch = process.env.WORKERS_CI_BRANCH;
const isPreview = Boolean(branch) && branch !== 'main';
const canonical = isError ? undefined : absolute(Astro.url.pathname);
const pageTitle = fullTitle(title);
const image = absolute(`/og/${og}.png`);
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {(isError || isPreview) && <meta name="robots" content="noindex" />}
    <link rel="preload" href={figtreeUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bricolageUrl} as="font" type="font/woff2" crossorigin />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#FBFCFD" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#14171F" media="(prefers-color-scheme: dark)" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <Header />
    <main id="content" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
